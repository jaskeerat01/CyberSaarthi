        "jsCode": "const observations = $input.all().map(i => ({\n  type: i.json.type,\n  normalised_value: i.json.normalised_value,\n  provider: i.json.provider,\n  outcome: i.json.outcome,\n  response_reference: i.json.response_reference || '',\n  error_detail: i.json.error_detail || ''\n}));\nconst scanId = $('Expand Indicators').first().json.scan_id;\nreturn [{ json: { scan_id: scanId, observations: observations } }];"
