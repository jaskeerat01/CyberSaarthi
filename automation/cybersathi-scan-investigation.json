    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst allowed = ['URL', 'DOMAIN', 'IP', 'PHONE', 'UPI', 'EMAIL'];\nconst indicators = Array.isArray(body.indicators) ? body.indicators : [];\nconst indicatorsOk = indicators.length >= 1 && indicators.length <= 50 && indicators.every(i => i && allowed.indexOf(i.type) !== -1 && typeof i.normalised_value === 'string' && i.normalised_value.length > 0 && i.normalised_value.length <= 2048);\nconst scanOk = typeof body.scan_id === 'string' && body.scan_id.length > 0 && body.scan_id.length <= 64;\nconst attemptOk = Number.isInteger(body.attempt) && body.attempt >= 1 && body.attempt <= 10;\nconst valid = scanOk && attemptOk && indicatorsOk;\nreturn [{ json: { valid: valid, scan_id: scanOk ? body.scan_id : '', attempt: attemptOk ? body.attempt : 0, indicators: valid ? indicators : [] } }];"
      },
