new file mode 100644
index 0000000..91aa712
--- /dev/null
+++ b/render.yaml
@@ -0,0 +1,82 @@
+# Render Blueprint: Postgres, Redis-compatible Key Value, API, Celery worker, and frontend.
+# Secrets marked sync: false are entered in the Render dashboard before the first deploy.
+
+envVarGroups:
+  - name: cybersathi-shared
+    envVars:
+      - key: DJANGO_SECRET_KEY
+        generateValue: true
+      - key: INTERNAL_SERVICE_TOKEN
+        generateValue: true
+      - key: IDENTIFIER_HMAC_KEY
+        sync: false
+      - key: IDENTIFIER_HMAC_KEY_ID
+        value: v1
+      - key: FIELD_ENCRYPTION_KEY
+        sync: false
+      - key: DATABASE_URL
+        fromDatabase:
+          name: cybersathi-db
+          property: connectionString
+      - key: REDIS_URL
+        fromService:
+          type: keyvalue
+          name: cybersathi-redis
+          property: connectionString
+      - key: N8N_WEBHOOK_URL
+        sync: false
+      - key: N8N_WEBHOOK_TOKEN
+        sync: false
+      - key: INTERNAL_API_BASE_URL
+        value: https://cybersathi-api.onrender.com
+      - key: FEATURE_PHISHTANK
+        value: "false"
+      - key: FEATURE_RDAP
+        value: "true"
+      - key: FEATURE_ABUSEIPDB
+        value: "false"
+      - key: VIRUSTOTAL_ENABLED
+        value: "false"
+      - key: CELERY_TASK_ALWAYS_EAGER
+        value: "true"
+
+databases:
+  - name: cybersathi-db
+    databaseName: cybersathi
+    user: cybersathi
+    plan: free
+    postgresMajorVersion: "16"
+
+keyvalue:
+  - name: cybersathi-redis
+    plan: free
+    maxmemoryPolicy: noeviction
+    ipAllowList: []
+
+services:
+  - type: web
+    name: cybersathi-api
+    runtime: docker
+    dockerContext: ./backend
+    dockerfilePath: ./backend/Dockerfile
+    healthCheckPath: /healthz
+    plan: free
+    envVars:
+      - key: DJANGO_ALLOWED_HOSTS
+        value: cybersathi-api.onrender.com
+    envVarGroups:
+      - cybersathi-shared
+
+  - type: web
+    name: cybersathi-web
+    runtime: static
+    rootDir: frontend
+    buildCommand: npm ci && npm run build
+    staticPublishPath: ./dist
+    routes:
+      - type: rewrite
+        source: /api/*
+        destination: https://cybersathi-api.onrender.com/api/*
+      - type: rewrite
+        source: /*
+        destination: /index.html
