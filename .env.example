# Backend
DJANGO_SECRET_KEY=<DJANGO_SECRET_KEY>
DJANGO_ALLOWED_HOSTS=<COMMA_SEPARATED_HOSTNAMES>
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
REDIS_URL=redis://<REDIS_HOST>:6379/0
IDENTIFIER_HMAC_KEY=<BASE64_ENCODED_32_BYTE_KEY>
IDENTIFIER_HMAC_KEY_ID=<KEY_VERSION_ID>
FIELD_ENCRYPTION_KEY=<FERNET_KEY>
INTERNAL_SERVICE_TOKEN=<INTERNAL_SERVICE_TOKEN>
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<TELEGRAM_WEBHOOK_SECRET_TOKEN>
PHISHTANK_API_KEY=<PHISHTANK_API_KEY>
OPENPHISH_FEED_URL=<OPENPHISH_FEED_URL>
VIRUSTOTAL_API_KEY=<VIRUSTOTAL_API_KEY>
VIRUSTOTAL_ENABLED=false
GOOGLE_WEB_RISK_API_KEY=<GOOGLE_WEB_RISK_API_KEY>
ABUSEIPDB_API_KEY=<ABUSEIPDB_API_KEY>
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
SENTRY_DSN=<OPTIONAL_SENTRY_DSN>

# n8n (workflow webhook and the internal API it calls)
N8N_BASE_URL=<N8N_BASE_URL>
N8N_WEBHOOK_URL=<N8N_BASE_URL>/webhook/cybersathi/scan-investigation
N8N_WEBHOOK_TOKEN=<N8N_WEBHOOK_HEADER_TOKEN>
INTERNAL_API_BASE_URL=<INTERNAL_API_BASE_URL>
FEATURE_PHISHTANK=true
FEATURE_RDAP=true
FEATURE_ABUSEIPDB=false

# Frontend (Vite; these are public values, never put secrets here)
VITE_API_BASE_URL=<API_BASE_URL>

# n8n MCP server (configured in OpenCode, not stored in this repository)
# The n8n API key belongs in the OpenCode MCP configuration or a local secret store.
N8N_API_URL=<N8N_BASE_URL>/api/v1
N8N_API_KEY=<N8N_API_KEY>
